[
	{
		"name": "Example - Abort",
		"trigger": {
            "every": "1d",
            "beginAt": "12:12"
        },
		"onFailure": "abort",
		"steps": [
			{
				"name": "abort step 1",
				"program": "./testprog",
				"args": [
					"-sleep",
					"10",
					"-role",
					"run and abort after step 1",
					"-exit-code",
					"1"
				],
				"timeout": 11,
				"pause": 3
			},
			{
				"name": "abort step 2",
				"program": "./testprog",
				"args": [
					"-sleep",
					"50",
					"-role",
					"should not run"
				],
				"pause": 5
			}
		]
	}
]
