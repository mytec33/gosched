[
	{
		"name": "Example - Abort",
		"enabled": true,
		"trigger": { "every": "1d", "beginAt": "19:40" },
		"onFailure": "abort",
		"steps": [
			{
				"name": "step 1 - exit failure",
				"program": "./testprog",
				"args": [
					"-sleep",
					"5",
					"-role",
					"run and abort after step 1",
					"-exit-code",
					"1"
				],
				"timeout": "20s",
				"pause": "5s"
			},
			{
				"name": "step 2 - should not run",
				"program": "./testprog",
				"args": [
					"-sleep",
					"50",
					"-role",
					"should not run"
				]
			}
		]
	}
]
